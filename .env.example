# Groq API
GROQ_API_KEY=your_groq_api_key_here

# JWT signing key (required). Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace_with_a_long_random_string

# Postgres connection string (required). Start a local one with:
# docker run -d --name stash-db -e POSTGRES_USER=stash -e POSTGRES_PASSWORD=stash -e POSTGRES_DB=stash -p 5432:5432 pgvector/pgvector:pg17
DATABASE_URL=postgresql://stash:stash@localhost:5432/stash
